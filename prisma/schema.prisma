generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model dev_log {
  id             Int       @id @default(autoincrement())
  notion_page_id String?   @unique
  title          String
  content        String
  published_at   DateTime  @db.Timestamptz(6)
  last_edited_at DateTime? @db.Timestamptz(6)
}

model playing_with_neon {
  id    Int    @id @default(autoincrement())
  name  String
  value Float? @db.Real
}
